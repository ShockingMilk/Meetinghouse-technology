# Copy this file to .env.training and use a distinct random secret.
DJANGO_SECRET_KEY=replace-with-a-different-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=0

# Keep bound to localhost for local preview. For a managed deployment, bind
# to the approved host interface and enforce public/private network access
# with the host firewall or network gateway.
TRAINING_BIND_ADDRESS=127.0.0.1
TRAINING_PORT=8081
