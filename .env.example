# Django
DJANGO_SECRET_KEY=replace-this-with-a-long-random-local-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_SECURE_SSL_REDIRECT=0

# Settings module
DJANGO_SETTINGS_MODULE=config.settings.development

# Database
DJANGO_DB_PATH=/app/data/db.sqlite3

# Application
DJANGO_LANGUAGE_CODE=en-us
DJANGO_TIME_ZONE=America/Los_Angeles

# Optional brand mark, supplied locally at static/branding/site-logo.png.
# Set this URL to use a different file without changing templates.
BRAND_LOGO_URL=/static/branding/site-logo.png

# Optional heading on unassigned-equipment identification labels.
ASSET_LABEL_SITE_HEADING=MEETINGHOUSE TECH

# Local development web port
WEB_PORT=8000

# Production management reverse proxy binding (localhost by default)
MANAGEMENT_BIND_ADDRESS=127.0.0.1
MANAGEMENT_PORT=8080
